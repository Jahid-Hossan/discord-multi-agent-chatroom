# এই ফাইলটা copy করে .env নামে save করো, তারপর দুটো secret বসাও।
# .env কখনো git-এ commit করবে না — .gitignore-এ ওটা আগেই বাদ দেওয়া আছে।

# CEO bot-এর Discord token (Developer Portal > তোমার app > Bot > Reset Token)
DISCORD_BOT_TOKEN=PASTE_CEO_BOT_TOKEN_HERE

# Gemini API key (Google AI Studio থেকে)
GEMINI_API_KEY=PASTE_GEMINI_API_KEY_HERE

# Jahid-এর Discord user ID (secret নয়, আগেই বসানো)
OWNER_ID=915608191985909761

# Muse bot-এর Discord user ID (secret নয়, আগেই বসানো)
MUSE_BOT_ID=1571775641651773521
